TYPESAFE_API_KEY=sk-...

# Public PostHog project token (phc_...), embedded in the browser bundle.
# Never use a PostHog personal API key here.
NEXT_PUBLIC_POSTHOG_KEY=phc_...

# Dollars of Jev input tokens this deployment may spend per UTC day.
JEV_DAILY_BUDGET_USD=1
# Calls one client IP may make per UTC day. One call scores one item.
JEV_IP_DAILY_CALLS=300
